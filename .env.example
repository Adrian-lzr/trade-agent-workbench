# =============================================================================
# Azure OpenAI (required)
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# =============================================================================
# Database Configuration
# All values can be set via environment variables OR in YAML config files.
# Environment variables take precedence over YAML values.
# Connection strings take precedence over individual connection parameters.
# =============================================================================

# -----------------------------------------------------------------------------
# Databricks
# -----------------------------------------------------------------------------
DATABRICKS_HOSTNAME=your-workspace.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxx
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_TOKEN=dapi...

# -----------------------------------------------------------------------------
# Azure SQL Database
# Option 1: Connection string (takes precedence)
# Option 2: Individual parameters with use_aad=true or password
# -----------------------------------------------------------------------------
AZURE_SQL_CONNECTION_STRING=
# OR individual parameters:
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USERNAME=your-username
AZURE_SQL_PASSWORD=
AZURE_SQL_USE_AAD=false
AZURE_SQL_DRIVER="ODBC Driver 18 for SQL Server"

# -----------------------------------------------------------------------------
# Azure Synapse Analytics
# Option 1: Connection string (takes precedence)
# Option 2: Individual parameters with use_aad=true or password
# -----------------------------------------------------------------------------
SYNAPSE_CONNECTION_STRING=
# OR individual parameters:
SYNAPSE_SERVER=your-workspace.sql.azuresynapse.net
SYNAPSE_DATABASE=your-database
SYNAPSE_USERNAME=your-username
SYNAPSE_PASSWORD=
SYNAPSE_USE_AAD=false
SYNAPSE_DRIVER="ODBC Driver 18 for SQL Server"
SYNAPSE_POOL=Built-in

# -----------------------------------------------------------------------------
# Azure Cosmos DB
# Option 1: Connection string (takes precedence)
# Option 2: Individual parameters with use_aad=true or key
# -----------------------------------------------------------------------------
COSMOS_CONNECTION_STRING=
# OR individual parameters:
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DATABASE=your-database
COSMOS_CONTAINER=your-container
COSMOS_KEY=
COSMOS_USE_AAD=false

# -----------------------------------------------------------------------------
# PostgreSQL
# Option 1: Connection string (takes precedence)
# Option 2: Individual parameters with use_aad=true or password
# -----------------------------------------------------------------------------
POSTGRES_CONNECTION_STRING=
# OR individual parameters:
POSTGRES_HOST=your-server.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=your-database
POSTGRES_USERNAME=your-username
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_USE_AAD=false

# -----------------------------------------------------------------------------
# Google BigQuery
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
BIGQUERY_DATASET=your-dataset
BIGQUERY_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
BIGQUERY_CREDENTIALS_JSON=

# =============================================================================
# Visualization (Optional)
# Requires Azure Container Apps Dynamic Sessions for secure code execution.
# See docs/CONFIGURATION.md for setup instructions.
# =============================================================================
AZURE_SESSIONS_POOL_ENDPOINT=https://eastus.dynamicsessions.io/subscriptions/xxx/resourceGroups/xxx/sessionPools/xxx

# =============================================================================
# Trade Agent local development (synthetic data only)
# =============================================================================
LANGGRAPH_STRICT_MSGPACK=true
TRADE_POSTGRES_DB=trade_agent
TRADE_POSTGRES_USER=trade_agent
TRADE_POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgresql+psycopg://trade_agent:local-dev-only@localhost:5432/trade_agent
# Read-only analytics defaults to an explicitly marked local Fake. Set real only
# after provisioning TRADE_ANALYTICS_USER with SELECT on the analytics views.
TRADE_ANALYTICS_MODE=fake
TRADE_ANALYTICS_USER=trade_agent_analytics
TRADE_ANALYTICS_PASSWORD=local-dev-only
TRADE_ANALYTICS_DATABASE_URL=postgresql+psycopg://trade_agent_analytics:local-dev-only@localhost:5432/trade_agent
# Compose app profile ports and worker behavior.
TRADE_API_PORT=8000
TRADE_FRONTEND_PORT=5173
VITE_API_MODE=demo
# Same-origin requests use the frontend nginx /api proxy. Set a full URL only
# when the browser should call a separately exposed API endpoint.
VITE_API_BASE_URL=
TRADE_WORKER_MODE=recovery
# The integration fixture drops/recreates only the trade_agent schema in this dedicated *_test database.
TRADE_TEST_POSTGRES_DB=trade_agent_test
TRADE_TEST_POSTGRES_PORT=5433
TRADE_TEST_DATABASE_URL=postgresql+psycopg://trade_agent:local-dev-only@localhost:5433/trade_agent_test
# Trade Agent model gateway defaults to an offline, fixture-driven Fake.
TRADE_MODEL_MODE=fake
# To opt into a real provider, set TRADE_MODEL_MODE=openai or azure_openai and
# configure the matching credentials, model/deployment, request cap, and output cap.
# See README.md for the required variable names. These caps apply per gateway
# instance and per request; configure an account-level budget with the provider.
